#!/usr/bin/env bash
set -euo pipefail

EXT_DIR="${NUON_EXT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=./scripts/lib.sh
source "$EXT_DIR/scripts/lib.sh"

unset NUON_APP_ID NUON_INSTALL_ID

ORG_NAME="${1:-Acme Demo}"
DEMO_APPS="${DEMO_APPS:-httpbin gcp-httpbin}"
DEMO_AWS_REGION="${DEMO_AWS_REGION:-us-west-2}"
DEMO_GCP_REGION="${DEMO_GCP_REGION:-us-central1}"
DEMO_STACK_WAIT_SECS="${DEMO_STACK_WAIT_SECS:-600}"
REPO_URL="https://github.com/nuonco/example-app-configs.git"
LOG_FILE="$(mktemp -t nuon-demo-setup.XXXXXX.log)"

for tool in "$NUON_BIN" terraform jq git curl aws; do
  need "$tool"
done
[ -n "${NUON_API_TOKEN:-}" ] || die "NUON_API_TOKEN not set (run through the extension after nuon auth login)"
[ -n "${NUON_API_URL:-}" ] || die "NUON_API_URL not set"

if [ -z "${AWS_PROFILE:-}" ] && ! aws sts get-caller-identity >/dev/null 2>&1; then
  read -r -p "AWS profile to provision into: " AWS_PROFILE
  export AWS_PROFILE
fi
aws sts get-caller-identity >/dev/null 2>&1 ||
  die "AWS credentials not usable (AWS_PROFILE=${AWS_PROFILE:-unset})"

GCP_PROJECT="${GOOGLE_PROJECT:-${CLOUDSDK_CORE_PROJECT:-}}"
if [ -z "$GCP_PROJECT" ] && command -v gcloud >/dev/null 2>&1; then
  GCP_PROJECT="$(gcloud config get-value project 2>/dev/null || true)"
fi

ORG_ID="$(nuon_data orgs create -n "$ORG_NAME" --no-select | jq -r .id)"
[ -n "$ORG_ID" ] && [ "$ORG_ID" != null ] || die "org creation returned no id"
export NUON_ORG_ID="$ORG_ID"
STATE_DIR="$DEMO_STATE_DIR/$ORG_ID"
mkdir -p "$STATE_DIR"
mv "$LOG_FILE" "$STATE_DIR/setup.log"
LOG_FILE="$STATE_DIR/setup.log"
log "org $ORG_NAME created: $ORG_ID (log: $LOG_FILE)"

WORK="$(mktemp -d -t nuon-demo.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT
git clone --quiet --depth 1 "$REPO_URL" "$WORK/configs"

for app in $DEMO_APPS; do
  dir="$WORK/configs/$app"
  [ -d "$dir" ] || die "no such example app: $app"
  cloud="$(awk '/^cloud:/{print $2}' "$dir/.meta.yaml")"
  case "$cloud" in
    aws)
      region="$DEMO_AWS_REGION"
      ;;
    gcp)
      region="$DEMO_GCP_REGION"
      if [ -z "$GCP_PROJECT" ]; then
        log "skipping $app: no GCP project (set GOOGLE_PROJECT)"
        continue
      fi
      ;;
    *)
      die "$app: unsupported cloud '$cloud' (only aws or gcp)"
      ;;
  esac

  log "$app: syncing config"
  "$NUON_BIN" --output agent apps sync "$dir" --create --force --no-wait -a "$app" \
    >>"$LOG_FILE" 2>&1 || die "$app: apps sync failed (see $LOG_FILE)"

  INSTALL_ID="$(nuon_data installs create -a "$app" -n "demo-$app" -r "$region" --no-select | jq -r .id)"
  [ -n "$INSTALL_ID" ] && [ "$INSTALL_ID" != null ] || die "$app: install creation returned no id"
  log "$app: install $INSTALL_ID created in $region"

  deadline=$((SECONDS + DEMO_STACK_WAIT_SECS))
  sa=""
  until sa="$(api_get "/v1/stacks/$INSTALL_ID/service-account" 2>/dev/null)"; do
    [ "$SECONDS" -lt "$deadline" ] ||
      die "$app: stack version not generated within ${DEMO_STACK_WAIT_SECS}s"
    sleep 10
  done

  SA_ID="$(jq -er .account_id <<<"$sa")"
  RUNNER_API_URL="${NUON_STACK_API_URL:-$(jq -er .runner_api_url <<<"$sa")}"
  STACK_TOKEN="$(nuon_data service-accounts tokens create --id "$SA_ID" --duration 8760h | jq -r .token)"

  tfdir="$STATE_DIR/$INSTALL_ID"
  mkdir -p "$tfdir"
  cp "$EXT_DIR/templates/$cloud/"*.tf "$tfdir/"
  {
    printf 'install_id = "%s"\n' "$INSTALL_ID"
    printf 'region = "%s"\n' "$region"
    printf 'nuon_runner_api_url = "%s"\n' "$RUNNER_API_URL"
    [ "$cloud" = gcp ] && printf 'project_id = "%s"\n' "$GCP_PROJECT"
  } >"$tfdir/terraform.tfvars"

  log "$app: terraform init/apply in $tfdir"
  (
    cd "$tfdir"
    NUON_API_TOKEN="$STACK_TOKEN" terraform init -input=false -no-color >>"$LOG_FILE" 2>&1
    NUON_API_TOKEN="$STACK_TOKEN" terraform apply -input=false -auto-approve -no-color 2>&1 |
      tee -a "$LOG_FILE"
  ) || die "$app: terraform apply failed; fix and re-run in $tfdir"
  log "$app: stack applied"
done

log "done. org=$ORG_ID state=$STATE_DIR"
log "teardown with: nuon demo-setup teardown $ORG_ID"