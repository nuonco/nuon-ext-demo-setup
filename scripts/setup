#!/usr/bin/env bash
set -euo pipefail

APPS=(
  "httpbin"
)

REPO_URL="https://github.com/nuonco/example-app-configs.git"
REPO_DIR="/tmp/example-app-configs"
LOG_FILE="/tmp/nuon-demo-setup.log"

# Get org name from argument or use default
ORG_NAME="${1:-Demo Test Setup}"

# Initialize log file
rm -f "$LOG_FILE"
echo "[$(date)] Demo setup started" >> "$LOG_FILE"

echo "========================================="
echo "  Nuon Demo Environment Setup"
echo "========================================="
echo ""
echo "💡 Tip: Watch logs in another terminal with: tail -f $LOG_FILE"
echo ""

# Prompt for AWS profile name
echo "🔐 AWS Profile Setup"
echo ""
read -p "Enter your AWS profile name (e.g., your-account.RoleName): " AWS_PROFILE_INPUT
echo ""

# Set the AWS profile
export AWS_PROFILE="$AWS_PROFILE_INPUT"
echo "[$(date)] User entered AWS profile: $AWS_PROFILE" >> "$LOG_FILE"

# Show the profile
echo "Current AWS Profile:"
echo $AWS_PROFILE
echo ""

# Prompt for confirmation
read -p "Proceed with this AWS profile? (y/n): " -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  echo ""
  echo "Please configure your AWS credentials and re-run this extension."
  echo ""
  echo "Exiting..."
  echo "[$(date)] User declined to proceed with AWS profile" >> "$LOG_FILE"
  exit 0
fi

echo "✓ Proceeding with profile: $AWS_PROFILE"
echo "[$(date)] User confirmed AWS profile: $AWS_PROFILE" >> "$LOG_FILE"
echo ""

echo "📦 Creating demo org: $ORG_NAME"
echo "[$(date)] Creating org: $ORG_NAME" >> "$LOG_FILE"
ORG_OUTPUT=$(nuon orgs create --name "$ORG_NAME" 2>&1)
echo "$ORG_OUTPUT"
echo "[$(date)] Org output: $ORG_OUTPUT" >> "$LOG_FILE"

# Extract org ID from output (format: "current org is now Name: orgid")
ORG_ID=$(echo "$ORG_OUTPUT" | grep -o 'org[a-z0-9]\+' | tail -1)

if [ -z "$ORG_ID" ]; then
  echo "❌ Failed to extract org ID from output"
  exit 1
fi

echo "✓ Org created successfully (ID: $ORG_ID)"
echo "[$(date)] Org created: $ORG_ID" >> "$LOG_FILE"

echo ""
echo "🔄 Selecting into new org..."
echo "[$(date)] Selecting org: $ORG_ID" >> "$LOG_FILE"
nuon orgs select --org "$ORG_ID"
echo "✓ Org selected"
echo "[$(date)] Org selected" >> "$LOG_FILE"

echo ""
echo "📥 Cloning example-app-configs repo..."
echo "[$(date)] Cloning repo from $REPO_URL" >> "$LOG_FILE"
rm -rf "$REPO_DIR"
git clone "$REPO_URL" "$REPO_DIR"
cd "$REPO_DIR"
echo "✓ Repository cloned"
echo "[$(date)] Repo cloned successfully" >> "$LOG_FILE"

echo ""
echo "🚀 Creating and syncing apps..."
echo ""

for app in "${APPS[@]}"; do
  if [ ! -d "$REPO_DIR/$app" ]; then
    echo "  ⚠️  Warning: Directory for $app not found, skipping..."
    echo "[$(date)] App directory not found: $app" >> "$LOG_FILE"
    continue
  fi
  
  echo "  📱 $app"
  echo "    → Changing to directory: $REPO_DIR/$app"
  echo "[$(date)] Processing app: $app" >> "$LOG_FILE"
  cd "$REPO_DIR/$app"
  echo "    → Directory changed successfully"
  
  echo "    → Running: nuon apps create --name $app"
  echo "[$(date)] Creating app: $app" >> "$LOG_FILE"
  APP_OUTPUT=$(nuon apps create --name "$app" 2>&1)
  echo "$APP_OUTPUT"
  echo "    ✓ App created"
  echo "[$(date)] App created successfully" >> "$LOG_FILE"
  
  echo "    → Running: nuon apps sync"
  echo "[$(date)] Syncing app: $app" >> "$LOG_FILE"
  SYNC_OUTPUT=$(nuon apps sync 2>&1)
  echo "$SYNC_OUTPUT"
  echo "    ✓ App synced"
  echo "[$(date)] App synced successfully" >> "$LOG_FILE"
  
  echo "    → Creating install: test-2"
  echo "[$(date)] Creating install: test-2" >> "$LOG_FILE"
  INSTALL_OUTPUT=$(nuon installs create --name test-2 --region us-west-2 2>&1)
  echo "$INSTALL_OUTPUT"
  
  # Extract install ID from output
  INSTALL_ID=$(echo "$INSTALL_OUTPUT" | grep -o 'inl[a-z0-9]\+' | head -1)
  
  if [ -z "$INSTALL_ID" ]; then
    echo "    ❌ Failed to extract install ID from output"
    echo "[$(date)] ERROR: Failed to extract install ID" >> "$LOG_FILE"
    exit 1
  fi
  
  echo "    ✓ Install created (ID: $INSTALL_ID)"
  echo "[$(date)] Install created: $INSTALL_ID" >> "$LOG_FILE"
  
  echo "    → Getting workflow ID..."
  echo "[$(date)] Fetching workflow ID for install: $INSTALL_ID" >> "$LOG_FILE"
  WORKFLOW_ID=$(nuon installs workflows list -i "$INSTALL_ID" -j 2>/dev/null | jq -r '.[0].id')
  
  if [ -z "$WORKFLOW_ID" ] || [ "$WORKFLOW_ID" = "null" ]; then
    echo "    ❌ Failed to get workflow ID"
    echo "[$(date)] ERROR: Failed to get workflow ID" >> "$LOG_FILE"
    exit 1
  fi
  
  echo "    ✓ Workflow ID: $WORKFLOW_ID"
  echo "[$(date)] Workflow ID: $WORKFLOW_ID" >> "$LOG_FILE"
  
  echo "    → Waiting for 'await install stack' step to be in-progress..."
  echo "[$(date)] Polling for 'await install stack' step" >> "$LOG_FILE"
  
  MAX_POLLS=60
  POLL_COUNT=0
  STEP_FOUND=false
  
  while [ $POLL_COUNT -lt $MAX_POLLS ]; do
    POLL_COUNT=$((POLL_COUNT + 1))
    
    # Get workflow status
    WORKFLOW_JSON=$(nuon installs workflows -i "$INSTALL_ID" -w "$WORKFLOW_ID" -j 2>/dev/null)
    
    # Check if "await install stack" step is in-progress
    STEP_STATUS=$(echo "$WORKFLOW_JSON" | jq -r '.step_groups[].steps[] | select(.name == "await install stack") | .status.status' 2>/dev/null | head -1)
    
    if [ "$STEP_STATUS" = "in-progress" ] || [ "$STEP_STATUS" = "queued" ]; then
      STEP_FOUND=true
      echo "    ✓ 'await install stack' step is now $STEP_STATUS"
      echo "[$(date)] Step found with status: $STEP_STATUS" >> "$LOG_FILE"
      break
    fi
    
    echo "[$(date)] Poll $POLL_COUNT/$MAX_POLLS - Step status: $STEP_STATUS" >> "$LOG_FILE"
    sleep 5
  done
  
  if [ "$STEP_FOUND" = false ]; then
    echo "    ⚠️  Timeout waiting for 'await install stack' step"
    echo "[$(date)] WARNING: Timeout waiting for step" >> "$LOG_FILE"
  else
    echo "    → Waiting additional 60 seconds for step to fully load..."
    echo "[$(date)] Waiting 60 seconds for step to stabilize" >> "$LOG_FILE"
    sleep 60
    echo "    ✓ Wait complete"
    echo "[$(date)] Wait complete, ready for next step" >> "$LOG_FILE"
  fi
  
  echo ""
done

echo "========================================="
echo "✓ Demo setup complete!"
echo "========================================="
echo ""
echo "Org Name: $ORG_NAME"
echo "Org ID: $ORG_ID"
echo "Apps created: ${APPS[*]}"
echo ""

echo "🧹 Cleaning up temporary files..."
echo "[$(date)] Cleaning up temporary files" >> "$LOG_FILE"
rm -rf "$REPO_DIR"
echo "✓ Cleanup complete"

echo "[$(date)] Demo setup completed successfully" >> "$LOG_FILE"
rm -f "$LOG_FILE"
echo ""